cases/**/build/
cases/**/images/
cases/**/mds/
cases/**/temppdfs/
cases/**/extracted/
cases/**/log.txt
cases/**/*_merge.log

# 事例 zip の作業用出力（scripts/ や Actions が作る）
dist/

# Python / エディタ
__pycache__/
*.pyc
.venv/
.vscode/
.idea/

# Office の一時ファイル
~$*
.~lock.*
Thumbs.db
.DS_Store
